# server
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://getit:getit@localhost:5432/getit
# Used by `npm test` (server integration tests). Must be a separate, throw-away database.
TEST_DATABASE_URL=postgresql://getit:getit@localhost:5432/getit_test
JWT_SECRET=change-me-to-a-long-random-string
DEVICE_SALT=change-me-to-another-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Optional AI helpers (group questions into topics, generate Quick Checks from slide text).
# Free key: https://aistudio.google.com → Get API key. Leave empty to hide the AI buttons.
GEMINI_API_KEY=
# Optional. Empty = gemini-flash-latest (Google's newest Flash model; specific versions get retired).
GEMINI_MODEL=
