{
  "name": "@getit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prisma": "node scripts/prisma.mjs",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "db:seed": "node scripts/prisma.mjs db seed",
    "postinstall": "prisma generate",
    "load-test": "tsx scripts/load-test.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@getit/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "prisma": "6.19.3",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
